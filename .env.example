# CryoPit local/development configuration.
# Copy to `.env` and uncomment only what you change.
# Production deployments should start from `.env.production.example`.

#CRYOPIT_DB_PATH=cryopit.db
#CRYOPIT_EXPORT_DIR=exports
#CRYOPIT_CAMPAIGN=CHANGE_ME
#CRYOPIT_RESEARCH_GROUP=CryoGARS
#CRYOPIT_INSTITUTION=Boise State University
#CRYOPIT_HOST=127.0.0.1
#CRYOPIT_PORT=8502
#CRYOPIT_THREADS=8  # shared-server default; tune only after representative load testing
#CRYOPIT_ENABLE_EDIT=true
#CRYOPIT_SHOW_EXAMPLE_PLACEHOLDERS=false
#CRYOPIT_SAVED_PITS_LIMIT=10
#CRYOPIT_SQLITE_JOURNAL=WAL
#CRYOPIT_FIGURE_DPI=150
#CRYOPIT_PROFILE_CONCURRENCY=2
#CRYOPIT_LOG_LEVEL=INFO

# Local mode: all requests share this owner and proxy identity headers are ignored.
#CRYOPIT_TRUST_PROXY_AUTH=false
#CRYOPIT_DEV_USER=local

# Trusted institutional SSO proxy mode. Do not enable unless the proxy is the
# only route to CryoPit and strips/replaces the identity header.
#CRYOPIT_TRUST_PROXY_AUTH=true
#CRYOPIT_AUTH_HEADER=X-Remote-User
#CRYOPIT_SECRET_KEY=replace-with-at-least-32-random-characters
#CRYOPIT_IDENTITY_MAX_LENGTH=255

# Request security and abuse controls.
#CRYOPIT_MAX_BODY_MB=16
#CRYOPIT_ATTACHMENT_MAX_MB=10
#CRYOPIT_HEIC_CONCURRENCY=1
#CRYOPIT_CSRF_TTL_SECONDS=43200
#CRYOPIT_RATE_LIMIT_WRITES_PER_MINUTE=120
#CRYOPIT_RATE_LIMIT_UPLOADS_PER_MINUTE=200
#CRYOPIT_RATE_LIMIT_EXPORTS_PER_MINUTE=12
#CRYOPIT_ENABLE_HSTS=false
